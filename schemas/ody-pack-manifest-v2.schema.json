{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ody-format/ody-format/main/schemas/ody-pack-manifest-v2.schema.json",
  "title": "ODY Pack Manifest v2",
  "description": "Der einheitliche Vertrag fuer alle ODY Packs: Karten, Wissen, Modelle, Bundles. Versioniert, quellenbelegt und pruefbar.",
  "type": "object",
  "required": ["schema_version", "identity", "capabilities", "review", "publisher", "files"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ody-pack-manifest/v2",
      "description": "Format-Version des Manifests."
    },
    "identity": {
      "type": "object",
      "required": ["pack_id", "display_name", "category", "language"],
      "additionalProperties": false,
      "properties": {
        "pack_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
          "description": "Eindeutige, portable ID (lowercase, Ziffern, Bindestrich, Unterstrich)."
        },
        "display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["maps", "knowledge", "procedures", "routing", "elevation", "dictionary", "model", "bundle"]
        },
        "language": {
          "type": "string",
          "description": "BCP-47 Sprachcode, z.B. de, en, fr."
        },
        "region_codes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "ISO-3166-2 oder benutzerdefinierte Regionscodes."
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["semantic", "built_at"],
      "additionalProperties": false,
      "properties": {
        "semantic": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Semantische Versionierung."
        },
        "built_at": { "type": "string", "format": "date-time" },
        "is_delta": { "type": "boolean", "default": false },
        "base_pack_id": {
          "type": "string",
          "description": "Nur wenn is_delta=true: Ziel-Pack des Patches."
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
      },
      "description": "Maschinenlesbare Faehigkeiten (z.B. FIRST_AID, WATER_TREATMENT) fuer Intent- und Capability-Routing."
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pack_id"],
            "additionalProperties": false,
            "properties": {
              "pack_id": { "type": "string" },
              "version_constraint": { "type": "string", "description": "z.B. >=1.2.0" }
            }
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pack_id"],
            "additionalProperties": false,
            "properties": {
              "pack_id": { "type": "string" },
              "version_constraint": { "type": "string" }
            }
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "description": "Herkunft und Transformationen. Pflicht fuer alle Inhalte, die als vertrauenswuerdig gelten sollen.",
      "required": ["source_dataset", "builder_version"],
      "additionalProperties": false,
      "properties": {
        "source_dataset": { "type": "string" },
        "source_record_ids": { "type": "array", "items": { "type": "string" } },
        "transformations": { "type": "array", "items": { "type": "string" } },
        "builder_version": { "type": "string" },
        "parent_pack": { "type": "string" }
      }
    },
    "freshness": {
      "type": "object",
      "required": ["source_published_at", "pack_built_at", "expiry_behavior"],
      "additionalProperties": false,
      "properties": {
        "source_published_at": { "type": "string", "format": "date" },
        "pack_built_at": { "type": "string", "format": "date" },
        "review_valid_until": { "type": "string", "format": "date" },
        "max_offline_age_days": { "type": "integer", "minimum": 0 },
        "expiry_behavior": {
          "type": "string",
          "enum": ["allow", "warn", "restrict", "block"]
        }
      }
    },
    "confidence": {
      "type": "object",
      "description": "Numerische Vertrauensbewertung je Dimension (0.0 bis 1.0).",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "publisher": {
      "type": "object",
      "required": ["publisher_id", "publisher_type"],
      "additionalProperties": false,
      "properties": {
        "publisher_id": { "type": "string" },
        "publisher_type": {
          "type": "string",
          "enum": ["official", "verified_partner", "community", "individual"]
        },
        "signing_key_id": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "description": "Review-Status und Pruefer. Definiert die Vertrauensstufe des Packs.",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unreviewed", "technical_demo", "community_reviewed", "editor_reviewed", "expert_reviewed"]
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reviewer_id"],
            "additionalProperties": false,
            "properties": {
              "reviewer_id": { "type": "string" },
              "qualification": { "type": "string" }
            }
          }
        },
        "reviewed_at": { "type": "string", "format": "date" }
      }
    },
    "content_governance": {
      "type": "object",
      "description": "Inhaltsklasse und Sicherheits-Gates. Medizinische Inhalte bleiben permanent PENDING_MEDICAL_REVIEW.",
      "required": ["declared_content_class"],
      "additionalProperties": false,
      "properties": {
        "declared_content_class": {
          "type": "string",
          "enum": ["NON_MEDICAL_PROCEDURE", "REFERENCE_DATA", "READER_METADATA", "MEDICAL_ADVISORY"]
        },
        "license_policy": { "type": "string" },
        "medical_governance": {
          "type": "object",
          "required": ["medical_schema_version", "review_status", "clinical_review_required", "allowed_behavior"],
          "additionalProperties": false,
          "properties": {
            "medical_schema_version": { "type": "string" },
            "review_status": { "type": "string", "const": "PENDING_MEDICAL_REVIEW" },
            "clinical_review_required": { "type": "boolean", "const": true },
            "allowed_behavior": { "type": "string", "const": "ADVISORY_ONLY" }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["hash_algorithm", "signature_algorithm"],
      "additionalProperties": false,
      "properties": {
        "hash_algorithm": { "type": "string", "const": "sha256" },
        "signature_algorithm": { "type": "string", "const": "ed25519" },
        "revocation_check_url": { "type": "string", "format": "uri" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["filename", "sha256", "size_bytes", "role"],
        "additionalProperties": false,
        "properties": {
          "filename": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "role": {
            "type": "string",
            "enum": ["primary", "index", "metadata", "delta", "map", "model"]
          },
          "variant": { "type": "string" }
        }
      }
    },
    "device_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_ody_version": { "type": "integer" },
        "min_ram_mb": { "type": "integer" },
        "min_storage_mb": { "type": "integer" }
      }
    }
  }
}